<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/signspeak_light_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/processing_settings"
                    android:textSize="18sp"
                    android:textColor="@color/signspeak_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_gpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/use_gpu_acceleration"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_gpu_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginStart="48dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/max_hands_label"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_decrease_hands"
                        style="@style/IconButton"
                        android:text="−" />

                    <TextView
                        android:id="@+id/tv_max_hands"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:layout_marginHorizontal="16dp"
                        android:text="1" />

                    <Button
                        android:id="@+id/btn_increase_hands"
                        style="@style/IconButton"
                        android:text="+" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/confidence_settings"
                    android:textSize="18sp"
                    android:textColor="@color/signspeak_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_detection_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detection_confidence_label"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_detection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.1"
                    android:valueTo="1.0"
                    android:stepSize="0.1"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_tracking_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tracking_confidence_label"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_tracking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.1"
                    android:valueTo="1.0"
                    android:stepSize="0.1"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tv_presence_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/presence_confidence_label"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_presence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.1"
                    android:valueTo="1.0"
                    android:stepSize="0.1" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save_settings"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/signspeak_primary"
            android:textColor="@android:color/white"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>
</ScrollView>