<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:elevation="8dp"
    android:padding="16dp">

    <!-- Max Hands Control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Max Hands:"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/maxHandsMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            style="@style/IconButton"/>

        <TextView
            android:id="@+id/maxHandsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:layout_marginHorizontal="8dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/maxHandsPlus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            style="@style/IconButton"/>
    </LinearLayout>

    <!-- Confidence Threshold Controls -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confidence Thresholds"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <!-- Detection Confidence -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detection:"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/detectionThresholdMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            style="@style/IconButton"/>

        <TextView
            android:id="@+id/detectionThresholdValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.50"
            android:layout_marginHorizontal="8dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/detectionThresholdPlus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            style="@style/IconButton"/>
    </LinearLayout>

    <!-- Tracking Confidence -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tracking:"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/trackingThresholdMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            style="@style/IconButton"/>

        <TextView
            android:id="@+id/trackingThresholdValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.50"
            android:layout_marginHorizontal="8dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/trackingThresholdPlus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            style="@style/IconButton"/>
    </LinearLayout>

    <!-- Presence Confidence -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presence:"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/presenceThresholdMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            style="@style/IconButton"/>

        <TextView
            android:id="@+id/presenceThresholdValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.50"
            android:layout_marginHorizontal="8dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/presenceThresholdPlus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            style="@style/IconButton"/>
    </LinearLayout>

    <!-- Delegate Selection -->
    <Spinner
        android:id="@+id/spinnerDelegate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/delegate_spinner_titles"/>

    <!-- Inference Time -->
    <TextView
        android:id="@+id/inferenceTimeVal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inference time: 0ms"
        android:layout_marginTop="8dp"
        android:textSize="14sp"/>
</LinearLayout>