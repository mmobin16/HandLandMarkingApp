<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/signspeak_background"
    tools:context=".fragment.IntroFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="24dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="292dp"
            android:layout_height="274dp"
            android:layout_marginBottom="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="SignSpeak Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/signspeak_logo_jpg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SignSpeak"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/signspeak_primary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A World Where Every Sign is Heard"
            android:textSize="20sp"
            android:textColor="@color/signspeak_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Let's Start"
            android:textSize="18sp"
            android:paddingHorizontal="48dp"
            android:paddingVertical="16dp"
            android:backgroundTint="@color/signspeak_primary"
            app:cornerRadius="24dp"/>

    </LinearLayout>

</RelativeLayout> 