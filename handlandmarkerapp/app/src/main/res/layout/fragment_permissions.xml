<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/signspeak_background"
    android:padding="24dp"
    tools:context=".fragment.PermissionsFragment">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/signspeak_logo_jpg"
        android:contentDescription="SignSpeak Logo"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Camera Permission Required"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/signspeak_text_primary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SignSpeak needs camera access to detect hand gestures. Please grant camera permission to continue."
        android:textSize="16sp"
        android:textColor="@color/signspeak_text_secondary"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grant Permission"
        android:textSize="16sp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        android:backgroundTint="@color/signspeak_primary"
        app:cornerRadius="24dp"/>

</LinearLayout> 